#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SDK_DIR="${ANDROID_HOME:-/home/efaz/Android/Sdk}"
ADB="$SDK_DIR/platform-tools/adb"
EMU="$SDK_DIR/emulator/emulator"
AVD_NAME="${MD_AVD_NAME:-Medium_Phone_API_36.1}"
AVD_HOME="${ANDROID_AVD_HOME:-/home/efaz/.config/.android/avd}"
SDK_HOME="${ANDROID_SDK_HOME:-/home/efaz/.config/.android}"
JAVA_HOME_DEFAULT="/home/efaz/.local/share/mise/installs/java/17.0.2"
JAVA_HOME="${JAVA_HOME:-$JAVA_HOME_DEFAULT}"
APP_ID="com.medownloader"

MODE="${1:-all}"

boot_emulator() {
  if "$ADB" devices | grep -q '^emulator-'; then
    echo "emulator already running"
    return
  fi

  echo "starting emulator: $AVD_NAME"
  ANDROID_AVD_HOME="$AVD_HOME" \
  ANDROID_SDK_HOME="$SDK_HOME" \
  nohup "$EMU" \
    -avd "$AVD_NAME" \
    -partition-size 8192 \
    -no-snapshot-save \
    > /tmp/opencode-meDownloader-emulator.log 2>&1 &
}

wait_for_boot() {
  echo "waiting for device"
  "$ADB" wait-for-device
  until [ "$("$ADB" shell getprop sys.boot_completed 2>/dev/null | tr -d '\r')" = "1" ]; do
    sleep 3
  done
  echo "device booted"
}

build_and_install() {
  echo "building and installing debug apk"
  cd "$ROOT_DIR"
  JAVA_HOME="$JAVA_HOME" ANDROID_HOME="$SDK_DIR" ./gradlew installDebug
}

launch_app() {
  echo "launching $APP_ID"
  "$ADB" shell monkey -p "$APP_ID" -c android.intent.category.LAUNCHER 1 >/dev/null
}

show_logs() {
  "$ADB" logcat | grep -E "MeDownloaderApp|YtDlpEngine|DownloadRepository|DownloadService|Aria2Native|Aria2ProcessManager"
}

case "$MODE" in
  boot)
    boot_emulator
    wait_for_boot
    ;;
  install)
    build_and_install
    ;;
  launch)
    launch_app
    ;;
  logs)
    show_logs
    ;;
  all)
    boot_emulator
    wait_for_boot
    build_and_install
    launch_app
    ;;
  *)
    echo "usage: ./scripts/test-android [boot|install|launch|logs|all]"
    exit 1
    ;;
esac
