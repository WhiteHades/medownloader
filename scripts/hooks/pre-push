#!/usr/bin/env bash
# pre-push hook installed by scripts/install-hooks.
#
# Runs the project's deterministic verification gates (compile + unit tests)
# before allowing a push. Mirrors the same gates used in GitHub Actions so
# CI and local diverge as little as possible.
#
# Skip this hook (at your own risk) with `git push --no-verify`.
set -euo pipefail

ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR"

JAVA_HOME_DEFAULT="/usr/lib/jvm/java-21-openjdk"
export JAVA_HOME="${JAVA_HOME:-$JAVA_HOME_DEFAULT}"

# Allow a local Chaquopy Maven override when testing patched builds.
# The default build resolves the public 17.0.0 release from chaquo.com/maven.
CHAQUOPY_MAVEN_DEFAULT="/home/efaz/Codes/chaquopy/maven"
if [ -z "${CHAQUOPY_MAVEN:-}" ] && [ -d "$CHAQUOPY_MAVEN_DEFAULT" ]; then
  export CHAQUOPY_MAVEN="$CHAQUOPY_MAVEN_DEFAULT"
fi

echo "[pre-push] compileDebugKotlin"
./gradlew :app:compileDebugKotlin --console=plain --quiet

echo "[pre-push] testDebugUnitTest"
./gradlew :app:testDebugUnitTest --console=plain --quiet

echo "[pre-push] ok"
